# MongoDB Atlas
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@cluster0.kdhnwwg.mongodb.net/?appName=Cluster0"
MONGODB_DB_NAME="canchalant"
MONGODB_COLLECTION="moments"
MONGODB_VECTOR_INDEX_NAME="vector_index"

# LM Studio Local Runtime (Optional Fallback)
LMSTUDIO_BASE_URL="http://localhost:1234/v1"
LMSTUDIO_API_KEY="lm-studio"
LOCAL_VISION_MODEL="abetlen/paligemma-3b-mix-224-gguf"

# Hugging Face Serverless Vision API
HF_TOKEN="hf_your_token_here"
HF_VISION_MODEL="google/paligemma-3b-pt-224"

# Application Settings
PORT=8000
HOST="0.0.0.0"
STORAGE_DIR="./captured_photos"
DEVICE="cuda"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_FOLDER="canchalant_snaps"
